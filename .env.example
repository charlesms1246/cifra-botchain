# ── Deployer ────────────────────────────────────────────────────────────────
# Fund on the BOT Chain testnet faucet: https://faucet.botchain.ai/basic
# (10 tBOT per address per 24h; chain ID 968). A full dual-book deploy costs
# roughly 0.3 BOT at the chain's fixed 20 gwei gas price.
PRIVATE_KEY="0x1234567890123456789012345678901234567890123456789012345678901234"

# ── BOT Chain RPC (defaults are the public endpoints; override to use your own) ──
# Mainnet  chainId 677 · explorer https://scan.botchain.ai
BOTCHAIN_RPC_URL="https://rpc.botchain.ai"
# Testnet  chainId 968 · explorer https://scan.bohr.life
BOTCHAIN_TESTNET_RPC_URL="https://rpc.bohr.life"

# Blockscout verification. The value is ignored by Blockscout but hardhat-verify
# refuses an empty string, so any non-empty token works.
BOTCHAIN_EXPLORER_API_KEY="blockscout"
BOTCHAIN_EXPLORER_URL="https://scan.botchain.ai"
BOTCHAIN_TESTNET_EXPLORER_URL="https://scan.bohr.life"

# ── Frontend ────────────────────────────────────────────────────────────────
# Privy enables email/social login and embedded wallets. Optional — without it the
# app runs on injected wallets alone.
# NOTE: Next.js only reads env files inside frontend/, and browser-visible vars must be
# NEXT_PUBLIC_-prefixed. Setting it here alone does nothing; mirror it to
# frontend/.env.local as NEXT_PUBLIC_PRIVY_APP_ID (npm run sync:privy does this).
PRIVY_APP_ID=""

# ── Cifra deployment config (all optional) ──────────────────────────────────
# The scoring service's signing key. CifraAttestationNFT accepts grades signed by
# this address only. Defaults to the deployer as a placeholder; repoint later with
# attestation.setScorerAddress(...) — that is also the upgrade path to a
# hardware-attested signer.
CIFRA_SCORER_ADDRESS=""
# Keeper permitted to call fundInvoice / record repayment + default. Defaults to deployer.
CIFRA_OPERATOR=""
# Subset of books to deploy, comma-separated. Default: "bot,usdt".
CIFRA_BOOKS=""
# Set to "false" to skip block-explorer verification after deploying.
VERIFY=""

# ── Legacy: Flare Coston2 (the pre-port deployment) ─────────────────────────
# Only needed to reproduce the original Flare deployment. Not used on BOT Chain.
FLARE_RPC_API_KEY=""
FLARE_EXPLORER_API_KEY="IrrelevantJustNeedsToBeNonempty"

# ═══════════════════════════════════════════════════════════════════════════
# MAINNET LAUNCH — fill these in before running claude-docs/MAINNET_RUNBOOK.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Governance (runbook §5) ────────────────────────────────────────────────
# Three ADDRESSES that will own every Cifra contract via a 2-of-3 Safe. Private keys are
# never needed here — the deploy only pays gas. Use hardware wallets or separate people;
# three keys on one laptop is a 1-of-1 wearing a costume.
GOV_OWNERS=""            # e.g. 0xAAA...,0xBBB...,0xCCC...   (comma-separated, no spaces)
GOV_THRESHOLD="2"

# ── Roles (runbook §4) ─────────────────────────────────────────────────────
# CIFRA_SCORER_ADDRESS is printed by scorer/scripts/provision-key.sh. It must be the key
# that exists ONLY inside Cloud Run — never this machine's key.
# CIFRA_ATTESTER submits signed grades on-chain; CIFRA_OPERATOR calls fundInvoice.
# They may be the same warm keeper, but neither should be the scorer or the deployer.
CIFRA_ATTESTER=""

# ── Deployment parameters (runbook §2) ─────────────────────────────────────
# Days past the due date before an invoice can be defaulted. IMMUTABLE once deployed —
# extending it later would silently move funders' risk. 3 is the default; for real
# receivables 14–30 is closer to commercial practice.
CIFRA_GRACE_DAYS="3"
# "true" enforces the funder allowlist from block one. Leaving it false still deploys the
# registry (bound immutably into the vaults), so it can be switched on by governance later
# without redeploying.
CIFRA_RESTRICT_FUNDERS="false"

# ── Scoring service on Cloud Run (runbook §3) ──────────────────────────────
GCP_PROJECT=""
GCP_REGION="europe-west1"
# The deployed service URL, used by scripts/e2eLifecycle.ts. Local default: http://localhost:8099
SCORER_URL=""

# ── Demo sizing (runbook §6) ───────────────────────────────────────────────
# Whole units of the book asset. Both tranches must together cover the advance
# (face x ~0.94), and junior alone should cover it for "senior protected" to be visible.
# Measured floor for a full two-path demo on the USDT book: 0.3 USDT total float.
DEMO_BOOK="bot"
DEMO_FACE="0.5"
DEMO_DEPOSIT="0.5"
