{
    "name": "cifra",
    "version": "0.1.0",
    "description": "Private invoice factoring on BOT Chain — off-chain scored risk grades, on-chain settlement",
    "license": "MIT",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "lint:sol": "solhint \"contracts/**/*.sol\"",
        "format:check": "prettier --check \"contracts/**/*.sol\" \"scripts/**/*.ts\"",
        "format:fix": "prettier --write \"contracts/**/*.sol\" \"scripts/**/*.ts\"",
        "deploy:testnet": "hardhat run scripts/deployCifra.ts --network botchainTestnet",
        "deploy:mainnet": "hardhat run scripts/deployCifra.ts --network botchain",
        "test:fork": "FORK=1 hardhat test test/fork/MainnetFork.test.ts",
        "sync:privy": "node -e \"const f=require('fs');const m=f.readFileSync('.env','utf8').match(/^\\s*(?:NEXT_PUBLIC_)?PRIVY_APP_ID\\s*=\\s*[\\\"']?([^\\\"'\\r\\n]+)/m);if(!m)throw new Error('no PRIVY_APP_ID in .env');f.writeFileSync('frontend/.env.local','NEXT_PUBLIC_PRIVY_APP_ID='+m[1].trim()+'\\n');console.log('synced')\""
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@types/chai": "^4.2.0",
        "@types/mocha": ">=9.1.0",
        "@types/node": ">=18.0.0",
        "chai": "^4.2.0",
        "dotenv": "^16.4.7",
        "hardhat": "^2.28.0",
        "prettier": "^3.6.2",
        "prettier-plugin-solidity": "^1.4.2",
        "solhint": "^4.5.2",
        "ts-node": "^10.9.2",
        "typescript": "~5.4.5",
        "viem": "^2.55.10"
    },
    "dependencies": {
        "@openzeppelin/contracts": "^5.2.0",
        "ethers": "^6.4.0"
    }
}
